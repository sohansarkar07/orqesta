{
  "name": "orqesta",
  "version": "0.1.1",
  "description": "Flagsmith configuration safety, environment drift detection, change forensics and policy enforcement CLI",
  "type": "module",
  "bin": {
    "orqesta": "./dist/src/cli/index.js",
    "orqesta-mcp": "./dist/src/mcp/server.js"
  },
  "files": [
    "dist/src",
    "dist/server",
    "examples",
    ".env.example",
    "README.md",
    "QUICKSTART.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohansarkar07/orqesta.git"
  },
  "homepage": "https://github.com/sohansarkar07/orqesta#readme",
  "bugs": {
    "url": "https://github.com/sohansarkar07/orqesta/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "cli": "tsx src/cli/index.ts",
    "server": "tsx server/index.ts",
    "server:prod": "node dist/server/index.js",
    "web": "npm run dev --prefix web",
    "test": "vitest run",
    "test:server": "vitest run server/tests",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:prod": "node dist/src/mcp/server.js"
  },
  "keywords": [
    "flagsmith",
    "feature-flags",
    "cli",
    "devops",
    "environment-drift"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/js-yaml": "^4.0.9",
    "axios": "^1.7.9",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "inquirer": "^12.3.0",
    "js-yaml": "^5.5.0",
    "ora": "^8.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "nock": "^13.5.6",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
