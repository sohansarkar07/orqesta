# Orqesta — environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Required: Flagsmith Organisation API Token (Management API)
# Obtain from: Flagsmith dashboard → Organisation Settings → API Keys
FLAGSMITH_API_KEY=your_organisation_api_token_here

# Optional: Override for self-hosted Flagsmith instances
# Default: https://api.flagsmith.com/api/v1
FLAGSMITH_API_URL=https://your-flagsmith-instance.example.com/api/v1

# Optional: Pin to a specific organisation (numeric ID)
FLAGSMITH_ORGANISATION_ID=

# Optional: Pin to a specific project (numeric ID)
FLAGSMITH_PROJECT_ID=
