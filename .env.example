# Orqesta — environment variable reference
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─────────────────────────────────────────────────────────────────────────────
# Management API credentials (required for most operations)
# Obtain from: Flagsmith dashboard → Organisation name → API Access → Create API Key
# ─────────────────────────────────────────────────────────────────────────────

# Preferred (new)
ORQUESTA_API_TOKEN=

# Legacy fallback — still accepted if ORQUESTA_API_TOKEN is not set
# FLAGSMITH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Management API base URL
# Default: https://api.flagsmith.com/api/v1
# Self-hosted: http://localhost:8000/api/v1
# ─────────────────────────────────────────────────────────────────────────────

# Preferred (new)
# ORQUESTA_API_URL=https://api.flagsmith.com/api/v1

# Legacy fallback
# FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Flags API key (optional — improves performance for compare/lint)
# Server-side environment key (ser. prefix) from:
# Flagsmith dashboard → Project → Environment → Settings → Server-side key
# ─────────────────────────────────────────────────────────────────────────────

# ORQUESTA_ENVIRONMENT_KEY=ser.xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# Flags API base URL (for the environment-document endpoint)
# Default: https://edge.api.flagsmith.com/api/v1
# Self-hosted: http://localhost:8000/api/v1
# ─────────────────────────────────────────────────────────────────────────────

# ORQUESTA_FLAGS_API_URL=https://edge.api.flagsmith.com/api/v1

# ─────────────────────────────────────────────────────────────────────────────
# Optional context
# ─────────────────────────────────────────────────────────────────────────────

# Pin to a specific project (numeric ID) — avoids selection prompt
# FLAGSMITH_PROJECT_ID=

# Server port (default: 3001)
# PORT=3001
